-- Database Creation
CREATE DATABASE PMOPortal;
USE PMOPortal;

-- Create Tables based on the PDF document

-- AdminUsers Table
CREATE TABLE AdminUsers (
    AdminUserId INT PRIMARY KEY AUTO_INCREMENT,
    Name VARCHAR(100) NOT NULL,
    Email VARCHAR(100) NOT NULL,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME NULL,
    UpdatedBy VARCHAR(100) NULL
);

-- Client Table
CREATE TABLE Client (
    ClientId INT PRIMARY KEY AUTO_INCREMENT,
    Client VARCHAR(200) NOT NULL,
    ClientShortCode VARCHAR(20) NOT NULL,
    AccountManager VARCHAR(100) NULL,
    ExecSponsor VARCHAR(100) NULL,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME NULL,
    UpdatedBy VARCHAR(100) NULL
);

-- CommercialVehicle Table
CREATE TABLE CommercialVehicle (
    CommercialVehicleId INT PRIMARY KEY AUTO_INCREMENT,
    CommercialVehicleName VARCHAR(100) NOT NULL
);

-- Contract Table - Central entity
CREATE TABLE Contract (
    ContractId INT PRIMARY KEY AUTO_INCREMENT,
    ClientId INT NOT NULL,
    Name VARCHAR(200) NOT NULL,
    ContractShortCode VARCHAR(20) NOT NULL,
    ContractValue DECIMAL(18, 2) NULL,
    ScrumMaster VARCHAR(100) NULL,
    PM VARCHAR(100) NULL,
    SPM VARCHAR(100) NULL,
    QS VARCHAR(100) NULL,
    SQS VARCHAR(100) NULL,
    RAG_Commercial VARCHAR(10) NULL,
    RAG_Budget VARCHAR(10) NULL,
    RAG_Time VARCHAR(10) NULL,
    RAG_Resource VARCHAR(10) NULL,
    RAG_Risk VARCHAR(10) NULL,
    RAG_Overall VARCHAR(10) NULL,
    RAG_Notes TEXT NULL,
    RAG_Invoicing VARCHAR(10) NULL,
    RAG_Action VARCHAR(100) NULL,
    ProfessionalServicesSpend_ABI DECIMAL(18, 2) NULL,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME NULL,
    UpdatedBy VARCHAR(100) NULL,
    PMEmail VARCHAR(100) NULL,
    ScrumMasterADProfileID VARCHAR(100) NULL,
    FOREIGN KEY (ClientId) REFERENCES Client(ClientId)
);

-- Commercial Table
CREATE TABLE Commercial (
    CommercialId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    CommercialVehicleId INT NOT NULL,
    Reference VARCHAR(100) NULL,
    ProfessionalServicesBudget DECIMAL(18, 2) NULL,
    ExpenseProvision DECIMAL(18, 2) NULL,
    ExpenseScenario VARCHAR(100) NULL,
    Signed BIT NULL,
    Notes TEXT NULL,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME NULL,
    UpdatedBy VARCHAR(100) NULL,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId),
    FOREIGN KEY (CommercialVehicleId) REFERENCES CommercialVehicle(CommercialVehicleId)
);

-- PurchaseOrder Table
CREATE TABLE PurchaseOrder (
    PurchaseOrderId INT PRIMARY KEY AUTO_INCREMENT,
    CommercialId INT NOT NULL,
    PONumber VARCHAR(50) NOT NULL,
    POAmount DECIMAL(18, 2) NOT NULL,
    Notes TEXT NULL,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME NULL,
    UpdatedBy VARCHAR(100) NULL,
    FOREIGN KEY (CommercialId) REFERENCES Commercial(CommercialId)
);

-- DaysOut Table (formerly DateOut in the diagram)
CREATE TABLE DaysOut (
    DaysOutId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    Consultant VARCHAR(100) NOT NULL,
    StartDate DATE NOT NULL,
    EndDate DATE NULL,
    IsHalfDay BIT NULL DEFAULT 0,
    ConsultantEmail VARCHAR(100) NULL,
    ConsultantADProfileID VARCHAR(100) NULL,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Risk Table
CREATE TABLE Risk (
    RiskId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    Impact VARCHAR(50) NULL,
    Owner VARCHAR(100) NULL,
    RiskLevel VARCHAR(20) NULL,
    Story TEXT NULL,
    SubjectArea VARCHAR(100) NULL,
    BlockingDetails TEXT NULL,
    DateRaised DATE NULL,
    Comments TEXT NULL,
    ContractRiskID VARCHAR(50) NULL,
    Status VARCHAR(50) NULL,
    DateLastUpdated DATE NULL,
    Active BIT NOT NULL DEFAULT 1,
    LastUpdatedBy VARCHAR(100) NULL,
    Item VARCHAR(100) NULL,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Assumption Table
CREATE TABLE Assumption (
    AssumptionId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    Assumption TEXT NOT NULL,
    DateRaised DATE NULL,
    Status VARCHAR(50) NULL,
    Active BIT NOT NULL DEFAULT 1,
    AssumptionBasis TEXT NULL,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Tasks Table
CREATE TABLE Tasks (
    TaskId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    WeekToggle VARCHAR(20) NULL,
    Task TEXT NOT NULL,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Engagement Table
CREATE TABLE Engagement (
    EngagementId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    EngagementName VARCHAR(200) NOT NULL,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Create Indexes for better performance
CREATE INDEX IX_Contract_ClientId ON Contract(ClientId);
CREATE INDEX IX_Commercial_ContractId ON Commercial(ContractId);
CREATE INDEX IX_Commercial_VehicleId ON Commercial(CommercialVehicleId);
CREATE INDEX IX_PurchaseOrder_CommercialId ON PurchaseOrder(CommercialId);
CREATE INDEX IX_DaysOut_ContractId ON DaysOut(ContractId);
CREATE INDEX IX_Risk_ContractId ON Risk(ContractId);
CREATE INDEX IX_Assumption_ContractId ON Assumption(ContractId);
CREATE INDEX IX_Tasks_ContractId ON Tasks(ContractId);
CREATE INDEX IX_Engagement_ContractId ON Engagement(ContractId);

