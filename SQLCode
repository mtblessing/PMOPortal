-- Database Creation
CREATE DATABASE IF NOT EXISTS PMOPortal;
USE PMOPortal;

-- AdminUsers Table
CREATE TABLE IF NOT EXISTS AdminUsers (
    AdminUserId INT PRIMARY KEY AUTO_INCREMENT,
    Name VARCHAR(100) NOT NULL,
    Email VARCHAR(100) NOT NULL,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME NULL,
    UpdatedBy VARCHAR(100) NULL
);

-- Client Table
CREATE TABLE IF NOT EXISTS Client (
    ClientId INT PRIMARY KEY AUTO_INCREMENT,
    ClientName VARCHAR(200) NOT NULL,
    ClientShortCode VARCHAR(20) NOT NULL,
    AccountManager VARCHAR(100) NULL,
    ExecSponsor VARCHAR(100) NULL,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME NULL,
    UpdatedBy VARCHAR(100) NULL
);

-- CommercialVehicle Table
CREATE TABLE IF NOT EXISTS CommercialVehicle (
    CommercialVehicleId INT PRIMARY KEY AUTO_INCREMENT,
    CommercialVehicleName VARCHAR(100) NOT NULL
);

DROP TABLE IF EXISTS Contract;

CREATE TABLE Contract (
    ContractId INT PRIMARY KEY AUTO_INCREMENT,
    AUR_WBS VARCHAR(50),
    SSE_Project_No VARCHAR(50),
    GSP_Region VARCHAR(50),
    Project_Stage VARCHAR(50),
    Project_Awarded DATE,
    Project_Status VARCHAR(50),
    Project_Title VARCHAR(255),
    Expected_CO_Contract_Value DECIMAL(18, 2),
    Contract_Award_Date DATE,
    AUR_Planner VARCHAR(100),
    AUR_SPM VARCHAR(100),
    AUR_PM VARCHAR(100),
    AUR_Design VARCHAR(100),
    AUR_Appointed_Designer VARCHAR(100),
    AUR_SQS VARCHAR(100),
    AUR_QS VARCHAR(100),
    Planned_Start_Date DATE,
    Section_Completion_Dates TEXT,
    Key_Dates TEXT,
    Design_End_Date DATE,
    Deliverables_Commence_Date DATE,
    Completion_Date DATE,
    Clause_31_Programme_Reqd BIT,
    Clause_31_Due_Date DATE,
    Clause_31_Submitted DATE,
    Kick_Off_Mtg_Held BIT,
    Designer_in_Contract BIT,
    Dalcour_Required BIT,
    Comments TEXT,
    Designer VARCHAR(100),
    SPM VARCHAR(100),
    Project_Manager VARCHAR(100),
    Contract_Manager VARCHAR(100),
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME,
    UpdatedBy VARCHAR(100),
    Active BIT NOT NULL DEFAULT 1
);

-- Commercial Table
CREATE TABLE IF NOT EXISTS Commercial (
    CommercialId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    AUR_WBS VARCHAR(50),
    SSE_Project_No VARCHAR(50),
    CommercialVehicleId INT NOT NULL,
    Reference VARCHAR(100),
    ProfessionalServicesBudget DECIMAL(18, 2),
    ExpenseProvision DECIMAL(18, 2),
    ExpenseScenario VARCHAR(100),
    Signed BIT,
    Notes TEXT,
    Active BIT NOT NULL DEFAULT 1,
    CreatedDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CreatedBy VARCHAR(100) NOT NULL,
    UpdatedDate DATETIME,
    UpdatedBy VARCHAR(100),
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId),
    FOREIGN KEY (CommercialVehicleId) REFERENCES CommercialVehicle(CommercialVehicleId)
);

-- Risk Table
CREATE TABLE IF NOT EXISTS Risk (
    RiskId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    Impact VARCHAR(50),
    Owner VARCHAR(100),
    RiskLevel VARCHAR(20),
    Story TEXT,
    SubjectArea VARCHAR(100),
    BlockingDetails TEXT,
    DateRaised DATE,
    Comments TEXT,
    ContractRiskID VARCHAR(50),
    Status VARCHAR(50),
    DateLastUpdated DATE,
    Active BIT NOT NULL DEFAULT 1,
    LastUpdatedBy VARCHAR(100),
    Item VARCHAR(100),
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Assumption Table
CREATE TABLE IF NOT EXISTS Assumption (
    AssumptionId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    Assumption TEXT NOT NULL,
    DateRaised DATE,
    Status VARCHAR(50),
    Active BIT NOT NULL DEFAULT 1,
    AssumptionBasis TEXT,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Tasks Table
CREATE TABLE IF NOT EXISTS Tasks (
    TaskId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT NOT NULL,
    WeekToggle VARCHAR(20),
    Task TEXT NOT NULL,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Missing tables (stubs so indexes don't fail)
CREATE TABLE IF NOT EXISTS PurchaseOrder (
    PurchaseOrderId INT PRIMARY KEY AUTO_INCREMENT,
    CommercialId INT,
    FOREIGN KEY (CommercialId) REFERENCES Commercial(CommercialId)
);

CREATE TABLE IF NOT EXISTS DaysOut (
    DaysOutId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

CREATE TABLE IF NOT EXISTS Engagement (
    EngagementId INT PRIMARY KEY AUTO_INCREMENT,
    ContractId INT,
    FOREIGN KEY (ContractId) REFERENCES Contract(ContractId)
);

-- Create Indexes
CREATE INDEX IX_Contract_ClientId ON Contract(ClientId);
CREATE INDEX IX_Commercial_ContractId ON Commercial(ContractId);
CREATE INDEX IX_Commercial_VehicleId ON Commercial(CommercialVehicleId);
CREATE INDEX IX_PurchaseOrder_CommercialId ON PurchaseOrder(CommercialId);
CREATE INDEX IX_DaysOut_ContractId ON DaysOut(ContractId);
CREATE INDEX IX_Risk_ContractId ON Risk(ContractId);
CREATE INDEX IX_Assumption_ContractId ON Assumption(ContractId);
CREATE INDEX IX_Tasks_ContractId ON Tasks(ContractId);
CREATE INDEX IX_Engagement_ContractId ON Engagement(ContractId);

